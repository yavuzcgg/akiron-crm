{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "akiron-crm",
    "Audience": "akiron-crm-web",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10
    }
  },
  "AllowedHosts": "*"
}
