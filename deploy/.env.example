# Copy to .env in the repository root on the server (chmod 600). Names only; never commit values.
# Generate each with: openssl rand -base64 36 | tr -d '/+='
POSTGRES_PASSWORD=
MINIO_PASSWORD=
JWT_SECRET=

# Leave empty to deliver to the built-in Mailpit (read at /mailpit). Set for a real relay.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
