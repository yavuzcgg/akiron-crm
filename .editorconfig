root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# The codebase is C# only; names like Error or Set colliding with VB keywords are not a concern.
dotnet_diagnostic.CA1716.severity = none

[**/Migrations/*.cs]
# Generated by dotnet ef.
generated_code = true
